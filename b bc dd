<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Document Generator</title>
<style>
  :root{
    --ink:#1c1f1a;
    --paper:#fbfaf7;
    --line:#d8d3c4;
    --accent:#5b6b4f;
    --accent-dark:#3f4a37;
    --muted:#7a7768;
    --field-bg:#f3f1e9;
    --warn:#9c4b3f;
  }
  *{box-sizing:border-box;}
  body{
    margin:0;
    font-family:'Georgia','Iowan Old Style',serif;
    background:#e9e6db;
    color:var(--ink);
  }
  /* ---------- App Shell (hidden on print) ---------- */
  .app-bar{
    background:var(--accent-dark);
    color:#f3f1e9;
    padding:14px 24px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    font-family:'Helvetica Neue',Arial,sans-serif;
  }
  .app-bar h1{
    font-size:16px;
    font-weight:600;
    letter-spacing:.04em;
    text-transform:uppercase;
    margin:0;
  }
  .app-bar .doc-switch{
    display:flex;
    gap:8px;
  }
  .app-bar select, .app-bar button{
    font-family:inherit;
    font-size:13px;
    padding:7px 12px;
    border-radius:4px;
    border:1px solid #6d7a62;
    background:#4b5840;
    color:#f3f1e9;
    cursor:pointer;
  }
  .app-bar button.primary{
    background:var(--accent);
    border-color:var(--accent);
    font-weight:600;
  }
  .app-bar button.primary:hover{background:#6c7d5e;}
  .app-bar select:hover, .app-bar button:hover{background:#5a6850;}

  .layout{
    display:flex;
    min-height:calc(100vh - 53px);
  }
  .editor-pane{
    width:380px;
    flex-shrink:0;
    background:#f1efe6;
    border-right:1px solid var(--line);
    padding:20px;
    overflow-y:auto;
    font-family:'Helvetica Neue',Arial,sans-serif;
  }
  .editor-pane h2{
    font-size:11px;
    text-transform:uppercase;
    letter-spacing:.08em;
    color:var(--muted);
    margin:18px 0 10px;
    border-bottom:1px solid var(--line);
    padding-bottom:6px;
  }
  .editor-pane h2:first-child{margin-top:0;}
  .field{
    margin-bottom:12px;
  }
  .field label{
    display:block;
    font-size:12px;
    font-weight:600;
    color:var(--accent-dark);
    margin-bottom:4px;
  }
  .field .hint{
    font-size:11px;
    color:var(--muted);
    margin-bottom:4px;
    font-style:italic;
  }
  .field input, .field textarea{
    width:100%;
    padding:8px 10px;
    border:1px solid var(--line);
    border-radius:3px;
    background:#fff;
    font-family:'Helvetica Neue',Arial,sans-serif;
    font-size:13px;
    color:var(--ink);
  }
  .field textarea{
    resize:vertical;
    min-height:60px;
  }
  .field input:focus, .field textarea:focus{
    outline:2px solid var(--accent);
    outline-offset:1px;
  }
  .tag-prefill{
    display:inline-block;
    font-size:9px;
    text-transform:uppercase;
    letter-spacing:.05em;
    background:#dfe6da;
    color:var(--accent-dark);
    padding:1px 6px;
    border-radius:2px;
    margin-left:6px;
    vertical-align:middle;
  }
  .tag-user{
    display:inline-block;
    font-size:9px;
    text-transform:uppercase;
    letter-spacing:.05em;
    background:#f0ded9;
    color:var(--warn);
    padding:1px 6px;
    border-radius:2px;
    margin-left:6px;
    vertical-align:middle;
  }

  .doc-pane{
    flex:1;
    padding:40px;
    display:flex;
    justify-content:center;
    overflow-y:auto;
  }
  .sheet{
    background:var(--paper);
    width:780px;
    max-width:100%;
    min-height:1000px;
    padding:70px 64px;
    box-shadow:0 2px 18px rgba(0,0,0,.18);
    line-height:1.6;
  }

  /* ---------- Document Content Styles ---------- */
  .doc-header{
    text-align:center;
    margin-bottom:36px;
    border-bottom:2px solid var(--accent-dark);
    padding-bottom:20px;
  }
  .doc-header .org-name{
    font-size:13px;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:var(--muted);
    margin-bottom:6px;
  }
  .doc-header .doc-title{
    font-size:30px;
    font-weight:700;
    color:var(--accent-dark);
    letter-spacing:.02em;
  }
  .doc-header .doc-subtitle{
    font-size:13px;
    color:var(--muted);
    margin-top:6px;
  }
  .doc-body p{margin:0 0 16px;}
  .doc-body .clause-title{
    font-weight:700;
    margin-top:22px;
    margin-bottom:6px;
    color:var(--accent-dark);
  }
  .fillable{
    background:var(--field-bg);
    border-bottom:1px solid var(--accent);
    padding:1px 4px;
    font-weight:600;
    color:var(--accent-dark);
  }
  .fillable.empty{
    color:#b5a9a0;
    font-style:italic;
    font-weight:400;
  }
  .sig-block{
    display:flex;
    justify-content:space-between;
    margin-top:60px;
    gap:40px;
  }
  .sig-line{
    flex:1;
  }
  .sig-line .line{
    border-bottom:1px solid var(--ink);
    height:36px;
  }
  .sig-line .label{
    font-size:12px;
    color:var(--muted);
    margin-top:4px;
    font-family:'Helvetica Neue',Arial,sans-serif;
  }
  .cert-body{
    text-align:center;
    padding-top:10px;
  }
  .cert-body .presented{
    font-size:14px;
    letter-spacing:.1em;
    text-transform:uppercase;
    color:var(--muted);
    margin-bottom:8px;
  }
  .cert-body .recipient{
    font-size:34px;
    font-weight:700;
    color:var(--accent-dark);
    margin:10px 0 18px;
    border-bottom:1px solid var(--line);
    display:inline-block;
    padding-bottom:8px;
  }
  .cert-body .desc{
    max-width:520px;
    margin:0 auto 26px;
    font-size:15px;
    color:var(--ink);
  }
  .cert-footer{
    display:flex;
    justify-content:space-around;
    margin-top:50px;
  }
  .cert-footer .sig-line{flex:none;width:220px;}

  /* ---------- Print ---------- */
  @media print{
    body{background:#fff;}
    .app-bar, .editor-pane{display:none !important;}
    .layout{display:block;}
    .doc-pane{padding:0;display:block;}
    .sheet{
      box-shadow:none;
      width:auto;
      min-height:0;
      padding:0;
      margin:0;
    }
    .fillable.empty{color:#999;}
  }
  @media (max-width:860px){
    .layout{flex-direction:column;}
    .editor-pane{width:100%;border-right:none;border-bottom:1px solid var(--line);}
    .sheet{padding:40px 24px;}
  }
</style>
</head>
<body>

<div class="app-bar">
  <h1>Document Generator</h1>
  <div class="doc-switch">
    <select id="docTypeSelect" onchange="switchDocType(this.value)">
      <option value="contract">Service Contract</option>
      <option value="certificate">Certificate of Completion</option>
    </select>
    <button class="primary" onclick="window.print()">🖨 Print / Save as PDF</button>
  </div>
</div>

<div class="layout">

  <!-- ============== EDITOR PANE ============== -->
  <div class="editor-pane">

    <!-- ---- CONTRACT FIELDS ---- -->
    <div id="editor-contract">
      <h2>Pre-filled details</h2>
      <div class="field">
        <label>Organization name <span class="tag-prefill">prefilled</span></label>
        <input type="text" id="c_orgName" oninput="render()" value="Riham Cybersecurity Solutions">
      </div>
      <div class="field">
        <label>Governing location <span class="tag-prefill">prefilled</span></label>
        <input type="text" id="c_jurisdiction" oninput="render()" value="Kampala, Uganda">
      </div>
      <div class="field">
        <label>Standard payment terms <span class="tag-prefill">prefilled</span></label>
        <input type="text" id="c_paymentTerms" oninput="render()" value="50% deposit upon signing, balance due on completion">
      </div>

      <h2>Enter for each contract</h2>
      <div class="field">
        <label>Client full name <span class="tag-user">your input</span></label>
        <input type="text" id="c_clientName" oninput="render()" placeholder="e.g. Jane Nansubuga">
      </div>
      <div class="field">
        <label>Client address <span class="tag-user">your input</span></label>
        <input type="text" id="c_clientAddress" oninput="render()" placeholder="e.g. Plot 12, Ntinda Road">
      </div>
      <div class="field">
        <label>Scope of work <span class="tag-user">your input</span></label>
        <textarea id="c_scope" oninput="render()" placeholder="e.g. Network vulnerability assessment and penetration testing of client's production servers">Network vulnerability assessment and penetration testing of client's production servers</textarea>
      </div>
      <div class="field">
        <label>Total fee <span class="tag-user">your input</span></label>
        <input type="text" id="c_fee" oninput="render()" placeholder="e.g. UGX 4,500,000">
      </div>
      <div class="field">
        <label>Start date <span class="tag-user">your input</span></label>
        <input type="date" id="c_startDate" oninput="render()">
      </div>
      <div class="field">
        <label>End date <span class="tag-user">your input</span></label>
        <input type="date" id="c_endDate" oninput="render()">
      </div>
      <div class="field">
        <label>Date signed <span class="tag-user">your input</span></label>
        <input type="date" id="c_signDate" oninput="render()">
      </div>
    </div>

    <!-- ---- CERTIFICATE FIELDS ---- -->
    <div id="editor-certificate" style="display:none;">
      <h2>Pre-filled details</h2>
      <div class="field">
        <label>Issuing organization <span class="tag-prefill">prefilled</span></label>
        <input type="text" id="t_orgName" oninput="render()" value="Riham Cybersecurity Solutions">
      </div>
      <div class="field">
        <label>Program name <span class="tag-prefill">prefilled</span></label>
        <input type="text" id="t_program" oninput="render()" value="Cybersecurity & Linux Server Hardening Internship">
      </div>
      <div class="field">
        <label>Standard closing remark <span class="tag-prefill">prefilled</span></label>
        <input type="text" id="t_remark" oninput="render()" value="awarded in recognition of dedication and successful completion of all program requirements">
      </div>

      <h2>Enter for each certificate</h2>
      <div class="field">
        <label>Recipient full name <span class="tag-user">your input</span></label>
        <input type="text" id="t_recipient" oninput="render()" placeholder="e.g. Pixel Okello">
      </div>
      <div class="field">
        <label>Date issued <span class="tag-user">your input</span></label>
        <input type="date" id="t_dateIssued" oninput="render()">
      </div>
      <div class="field">
        <label>Signatory 1 name <span class="tag-user">your input</span></label>
        <input type="text" id="t_sig1" oninput="render()" placeholder="e.g. Director of Operations">
      </div>
      <div class="field">
        <label>Signatory 2 name <span class="tag-user">your input</span></label>
        <input type="text" id="t_sig2" oninput="render()" placeholder="e.g. Program Supervisor">
      </div>
    </div>

  </div>

  <!-- ============== DOCUMENT PANE ============== -->
  <div class="doc-pane">
    <div class="sheet" id="sheet">
      <!-- filled in by render() -->
    </div>
  </div>

</div>

<script>
function val(id){
  const el = document.getElementById(id);
  return el ? el.value.trim() : "";
}
function fmtDate(v){
  if(!v) return "";
  const d = new Date(v + "T00:00:00");
  if(isNaN(d)) return v;
  return d.toLocaleDateString('en-GB', { day:'numeric', month:'long', year:'numeric' });
}
function fillable(text, placeholder){
  if(!text) return `<span class="fillable empty">[${placeholder}]</span>`;
  return `<span class="fillable">${escapeHtml(text)}</span>`;
}
function escapeHtml(s){
  return s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;");
}

function switchDocType(type){
  document.getElementById('editor-contract').style.display = type === 'contract' ? 'block' : 'none';
  document.getElementById('editor-certificate').style.display = type === 'certificate' ? 'block' : 'none';
  render();
}

function renderContract(){
  const orgName       = val('c_orgName') || "[Organization Name]";
  const jurisdiction   = val('c_jurisdiction') || "[Jurisdiction]";
  const paymentTerms   = val('c_paymentTerms') || "[Payment Terms]";
  const clientName     = val('c_clientName');
  const clientAddress  = val('c_clientAddress');
  const scope          = val('c_scope');
  const fee            = val('c_fee');
  const startDate      = fmtDate(val('c_startDate'));
  const endDate        = fmtDate(val('c_endDate'));
  const signDate       = fmtDate(val('c_signDate'));

  return `
    <div class="doc-header">
      <div class="org-name">${escapeHtml(orgName)}</div>
      <div class="doc-title">Service Contract Agreement</div>
      <div class="doc-subtitle">Governed under the laws applicable in ${escapeHtml(jurisdiction)}</div>
    </div>
    <div class="doc-body">
      <p>This Service Contract Agreement ("Agreement") is entered into on ${fillable(signDate,'Date Signed')}, between <strong>${escapeHtml(orgName)}</strong> ("the Provider") and ${fillable(clientName,'Client Full Name')}, residing at ${fillable(clientAddress,'Client Address')} ("the Client").</p>

      <div class="clause-title">1. Scope of Work</div>
      <p>The Provider agrees to perform the following services for the Client: ${fillable(scope,'Scope of Work')}.</p>

      <div class="clause-title">2. Term</div>
      <p>This Agreement shall commence on ${fillable(startDate,'Start Date')} and shall remain in effect until ${fillable(endDate,'End Date')}, unless terminated earlier in accordance with the terms herein.</p>

      <div class="clause-title">3. Payment Terms</div>
      <p>The total fee for the services described above is ${fillable(fee,'Total Fee')}. Payment shall be made as follows: ${escapeHtml(paymentTerms)}.</p>

      <div class="clause-title">4. Confidentiality</div>
      <p>Both parties agree to keep confidential any proprietary or sensitive information disclosed during the course of this engagement, and not to share such information with third parties without prior written consent.</p>

      <div class="clause-title">5. Governing Law</div>
      <p>This Agreement shall be governed by and construed in accordance with the laws applicable in ${escapeHtml(jurisdiction)}.</p>

      <div class="sig-block">
        <div class="sig-line">
          <div class="line"></div>
          <div class="label">${escapeHtml(orgName)} — Authorized Signatory</div>
        </div>
        <div class="sig-line">
          <div class="line"></div>
          <div class="label">${clientName ? escapeHtml(clientName) : 'Client'} — Signature</div>
        </div>
      </div>
    </div>
  `;
}

function renderCertificate(){
  const orgName     = val('t_orgName') || "[Organization Name]";
  const program     = val('t_program') || "[Program Name]";
  const remark      = val('t_remark') || "[closing remark]";
  const recipient   = val('t_recipient');
  const dateIssued  = fmtDate(val('t_dateIssued'));
  const sig1        = val('t_sig1');
  const sig2        = val('t_sig2');

  return `
    <div class="doc-header" style="border-bottom:none;">
      <div class="org-name">${escapeHtml(orgName)}</div>
      <div class="doc-title">Certificate of Completion</div>
    </div>
    <div class="cert-body">
      <div class="presented">This certificate is proudly presented to</div>
      <div class="recipient">${recipient ? escapeHtml(recipient) : '[Recipient Full Name]'}</div>
      <div class="desc">
        for successful completion of the <strong>${escapeHtml(program)}</strong>,
        ${escapeHtml(remark)}.
      </div>
      <p>Issued on ${fillable(dateIssued,'Date Issued')}</p>

      <div class="cert-footer">
        <div class="sig-line">
          <div class="line"></div>
          <div class="label">${sig1 ? escapeHtml(sig1) : 'Signatory'}</div>
        </div>
        <div class="sig-line">
          <div class="line"></div>
          <div class="label">${sig2 ? escapeHtml(sig2) : 'Signatory'}</div>
        </div>
      </div>
    </div>
  `;
}

function render(){
  const type = document.getElementById('docTypeSelect').value;
  document.getElementById('sheet').innerHTML = type === 'contract' ? renderContract() : renderCertificate();
}

render();
</script>

</body>
</html>